generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(uuid())
  googleId              String?        @unique
  username              String         @unique
  email                 String         @unique
  password              String
  phone_no              Int?
  is_verified           Boolean?
  role                  Role           @default(USER)
  userType              UserType?
  likesCount            Int[]
  dislikesCount         Int[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  blockedList           Blocklist[]    @relation("BlockedUserBlacklist")
  blockerList           Blocklist[]    @relation("BlockerBlacklist")

  chatsAsParticipantOne Chat[]         @relation("ParticipantOneChat")
  chatsAsParticipantTwo Chat[]         @relation("ParticipantTwoChat")

  matchesAsUserOne      Match[]        @relation("UserOneMatch")
  matchesAsUserTwo      Match[]        @relation("UserTwoMatch")

  receivedMessages      Message[]      @relation("ReceiverMessage")
  sentMessages          Message[]      @relation("SenderMessage")

  notificationsReceived Notification[] @relation("NotificationUser")
  notificationsSent     Notification[] @relation("NotificationRelating")

  reportedReports       ReportList[]   @relation("ReportedUserReportList")
  reporterReports       ReportList[]   @relation("ReporterReportList")

  userDetails           UserDetails?

  likesGiven            Like[]         @relation("UserOneLike")
  likesReceived         Like[]         @relation("UserTwoLike")

  unlikesGiven          Unlike[]       @relation("UserOneUnlike")
  unlikesReceived       Unlike[]       @relation("UserTwoUnlike")
}


model UserDetails {
  id                      String        @id @default(uuid())
  user_id                 String?       @unique
  dob                     String
  profile_photo           String
  background_img          String
  bio                     String
  occupation              String
  education               String
  location                String[]
  marital_status          MaritalStatus
  children                Int
  preferred_family_system String
  requirements            String[]
  deal_breakers           String
  timeframe_for_marriage  String
  family_details          String[]
  hobbies                 String[]
  interests               String[]
  distance                String
  media                   String[]
  isFeatured              Boolean?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  user                    User?         @relation(fields: [user_id], references: [id])
}

model Like {
  id         String  @id @default(uuid())
  liked_by   String
  liked_to   String
  createdAt  DateTime @default(now())
  likedBy    User?    @relation("UserOneLike", fields:[liked_by], references:[id])
  likedTo    User?    @relation("UserTwoLike", fields:[liked_to], references:[id])
}

model Unlike {
  id          String   @id @default(uuid())
  unliked_by  String
  unliked_to  String
  createdAt   DateTime @default(now())

  unlikedBy   User?    @relation("UserOneUnlike", fields: [unliked_by], references: [id])
  unlikedTo   User?    @relation("UserTwoUnlike", fields: [unliked_to], references: [id])
}



model Match {
  id        String   @id @default(uuid())
  user_one  String?
  user_two  String?
  chat_id   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chat      Chat?    @relation("MatchChat")
  userOne   User?    @relation("UserOneMatch", fields: [user_one], references: [id])
  userTwo   User?    @relation("UserTwoMatch", fields: [user_two], references: [id])
}

model Chat {
  id              String    @id @default(uuid())
  match_id        String?   @unique
  participant_one String?
  participant_two String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  match           Match?    @relation("MatchChat", fields: [match_id], references: [id])
  participantOne  User?     @relation("ParticipantOneChat", fields: [participant_one], references: [id])
  participantTwo  User?     @relation("ParticipantTwoChat", fields: [participant_two], references: [id])
  messages        Message[] @relation("ChatMessages")
}

model Message {
  id          String         @id @default(uuid())
  chat_id     String?
  sender_id   String?
  receiver_id String?
  status      MessageStatus?
  type        MessageType?
  content     String
  media_url   String?
  is_deleted  Boolean?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  chat        Chat?          @relation("ChatMessages", fields: [chat_id], references: [id])
  receiver    User?          @relation("ReceiverMessage", fields: [receiver_id], references: [id])
  sender      User?          @relation("SenderMessage", fields: [sender_id], references: [id])
  reports     ReportList[]
}


model ReportList {
  id               String        @id @default(uuid())
  reporter_id      String?
  reported_user_id String?
  message_id       String?
  reason           String
  description      String
  status           ReportStatus?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  message          Message?      @relation(fields: [message_id], references: [id])
  reportedUser     User?         @relation("ReportedUserReportList", fields: [reported_user_id], references: [id])
  reporter         User?         @relation("ReporterReportList", fields: [reporter_id], references: [id])
}

model Blocklist {
  id              String   @id @default(uuid())
  blocker_id      String?
  blocked_user_id String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  blockedUser     User?    @relation("BlockedUserBlacklist", fields: [blocked_user_id], references: [id])
  blocker         User?    @relation("BlockerBlacklist", fields: [blocker_id], references: [id])
}

model Notification {
  id            String            @id @default(uuid())
  user_id       String?
  user_relating String?
  title         String?
  description   String?
  type          NotificationType?
  isRead        Boolean?
  createdAt     DateTime?         @default(now())
  updatedAt     DateTime?         @updatedAt
  user          User?             @relation("NotificationUser", fields: [user_id], references: [id])
  relatedUser   User?             @relation("NotificationRelating", fields: [user_relating], references: [id])
}

model Terms {
  id            String   @id @default(uuid())
  terms_details Json     // Change to Json type
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PrivacyPolicy {
  id        String   @id @default(uuid())
  policies  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guidelines {
  id         String   @id @default(uuid())
  guidelines String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum UserType {
  basic
  premium
}

enum MaritalStatus {
  married
  unmarried
  prefer_not_say
  seperated
}

enum MessageStatus {
  sending
  delivered
  Read
  failed
}

enum MessageType {
  text
  voice
  photo
  emoji
  gifs
}

enum ReportStatus {
  pending
  approved
}

enum NotificationType {
  new_match
  new_message
  like_found
}

enum Role {
  ADMIN
  USER
}
